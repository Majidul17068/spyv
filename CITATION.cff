    given-names: "Md. Majidul"
    orcid: "https://orcid.org/0009-0005-2971-8897"
repository-code: "https://github.com/Majidul17068/spyv"
url: "https://pypi.org/project/spyv/"
license: Apache-2.0
version: "0.5.0"
date-released: "2026-09-07"
keywords:
  - prompt security
  - large language models
  - LLM agents
  - prompt injection
  - static analysis
  - software repository mining
  - guardrails
  - red teaming
